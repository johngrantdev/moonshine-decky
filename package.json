{
  "name": "moonshine-decky",
  "version": "0.1.0",
  "description": "Safely configure Moonshine's server name, HDR and Steam mode from Steam Game Mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -v",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johngrantdev/moonshine-decky"
  },
  "keywords": [
    "decky",
    "plugin",
    "moonshine",
    "moonlight",
    "steam-bootc"
  ],
  "author": "steam-bootc",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.5.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@10.15.1"
}
